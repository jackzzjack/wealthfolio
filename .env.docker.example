# Copy to .env and fill in before running: docker compose up

# ── Required ──────────────────────────────────────────────────────────────────

# 32-byte secret key for JWT signing and secrets encryption.
# Generate: openssl rand -base64 32
WF_SECRET_KEY=

# ── Authentication ─────────────────────────────────────────────────────────────

# Argon2id hash of your login password.
# Generate (requires argon2 CLI):
#   printf 'your-password' | argon2 $(openssl rand -hex 8) -id -e
# Leave blank + set WF_AUTH_REQUIRED=false for local/trusted-network only.
WF_AUTH_PASSWORD_HASH=
WF_AUTH_REQUIRED=true

# ── Network ───────────────────────────────────────────────────────────────────

# Host port mapped to container port 8080
WF_HOST_PORT=8080

# Cookie Secure flag: auto | true | false
# auto = Secure only when behind HTTPS reverse proxy (recommended)
WF_COOKIE_SECURE=auto

# Allowed CORS origins. Must be explicit (not *) when auth is enabled.
# Example: https://wealthfolio.mydomain.com
WF_CORS_ALLOW_ORIGINS=*

# ── Wealthfolio Connect (optional) ────────────────────────────────────────────
CONNECT_AUTH_URL=
CONNECT_AUTH_PUBLISHABLE_KEY=
CONNECT_API_URL=
